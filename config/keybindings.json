[
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "(!terminalFocus && !inputFocus || editorTextFocus && vim.active && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/) && !(auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus)"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "(!terminalFocus && !inputFocus || editorTextFocus && vim.active && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/) && !(auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus)"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "(!terminalFocus && !inputFocus || editorTextFocus && vim.active && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/) && !(auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus)"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "(!terminalFocus && !inputFocus || editorTextFocus && vim.active && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/) && !(auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus)"
  },
  {
    "key": "tab",
    "command": "workbench.action.nextEditorInGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !editorTabMovesFocus"
  },
  {
    "key": "shift+tab",
    "command": "workbench.action.previousEditorInGroup",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !editorTabMovesFocus"
  },
  {
    "key": "space n",
    "command": "vimNavigation.closeExplorer",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "enter",
    "command": "vimNavigation.replaceCurrentTab",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsFolder"
  },
  {
    "key": "t",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsFolder"
  },
  {
    "key": "space",
    "command": "vimNavigation.captureSidebarVisibility",
    "args": {
      "visible": true
    },
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && sideBarVisible"
  },
  {
    "key": "space",
    "command": "vimNavigation.captureSidebarVisibility",
    "args": {
      "visible": false
    },
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal' && !sideBarVisible"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus"
  },
  {
    "key": "ctrl+j",
    "command": "",
    "when": "auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus"
  },
  {
    "key": "ctrl+k",
    "command": "",
    "when": "auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus"
  },
  {
    "key": "ctrl+l",
    "command": "",
    "when": "auxiliaryBarVisible && (focusedView == 'chatgpt.sidebarSecondaryView' || webviewId == 'chatgpt.sidebarSecondaryView' || activeWebviewPanelId == 'chatgpt.sidebarSecondaryView') && !findInputFocussed && !inQuickOpen && !terminalFocus"
  },
  {
    "key": "ctrl+s",
    "command": "vim.remap",
    "args": {
      "after": [
        "<C-s>"
      ]
    },
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+h",
    "command": "vim.remap",
    "args": {
      "after": [
        "<C-h>"
      ]
    },
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "enter",
    "command": "vim.remap",
    "args": {
      "after": [
        "<Enter>"
      ]
    },
    "when": "editorTextFocus && vim.active && vim.mode =~ /^(Normal|Visual|VisualLine|VisualBlock)$/"
  }
]
